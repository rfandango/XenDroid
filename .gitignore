/emulator-core/src/main/cpp/xenia/third_party/snappy/CMakeFiles/
# Ignore snappy's in-source CMake build outputs, but KEEP the upstream source
# templates (config.h.in / SnappyConfig.cmake.in) -- they are required build
# inputs, and ignoring the whole cmake/ dir dropped them from history, breaking
# fresh checkouts/worktrees.
/emulator-core/src/main/cpp/xenia/third_party/snappy/cmake/*
!/emulator-core/src/main/cpp/xenia/third_party/snappy/cmake/config.h.in
!/emulator-core/src/main/cpp/xenia/third_party/snappy/cmake/SnappyConfig.cmake.in
/emulator-core/src/main/cpp/xenia/third_party/snappy/ALL_BUILD.vcxproj
/emulator-core/src/main/cpp/xenia/third_party/snappy/ALL_BUILD.vcxproj.filters
/emulator-core/src/main/cpp/xenia/third_party/snappy/cmake_install.cmake
/emulator-core/src/main/cpp/xenia/third_party/snappy/CMakeCache.txt
/emulator-core/src/main/cpp/xenia/third_party/snappy/INSTALL.vcxproj
/emulator-core/src/main/cpp/xenia/third_party/snappy/INSTALL.vcxproj.filters
/emulator-core/src/main/cpp/xenia/third_party/snappy/Snappy.sln
/emulator-core/src/main/cpp/xenia/third_party/snappy/snappy.vcxproj
/emulator-core/src/main/cpp/xenia/third_party/snappy/snappy.vcxproj.filters
/emulator-core/src/main/cpp/xenia/third_party/snappy/snappy-stubs-public.h
/emulator-core/src/main/cpp/xenia/third_party/snappy/ZERO_CHECK.vcxproj
/emulator-core/src/main/cpp/xenia/third_party/snappy/ZERO_CHECK.vcxproj.filters

